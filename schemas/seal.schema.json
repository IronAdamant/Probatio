{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IronAdamant/Probatio/blob/main/schemas/seal.schema.json",
  "flags": [
    {
      "name": "state",
      "required": true
    },
    {
      "name": "from",
      "required": false
    },
    {
      "name": "id",
      "required": false
    },
    {
      "name": "fraction",
      "required": false
    },
    {
      "name": "seed",
      "required": false
    },
    {
      "name": "out",
      "required": false
    }
  ],
  "title": "probatio seal",
  "description": "Writes the sealed slice that gap-fixing agents do not see. Every command prints one JSON object. schemaVersion changes when a field is renamed, removed, or changes meaning. A new field does not change it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "summary",
    "next",
    "nextCall"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "seal"
    },
    "summary": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCall": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    },
    "sealedCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "schemaVersion",
      "ok",
      "command",
      "summary",
      "next",
      "nextCall"
    ]
  }
}
