{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IronAdamant/Probatio/blob/main/schemas/findings.add.schema.json",
  "title": "probatio findings.add",
  "description": "Appends a decision to the findings log. Every command prints one JSON object. schemaVersion changes when a field is renamed, removed, or changes meaning. A new field does not change it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "summary",
    "next",
    "nextCall"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "findings.add"
    },
    "summary": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCall": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    }
  }
}
