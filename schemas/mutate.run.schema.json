{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IronAdamant/Probatio/blob/main/schemas/mutate.run.schema.json",
  "flags": [
    {
      "name": "hide",
      "required": false
    },
    {
      "name": "only-test",
      "required": false
    },
    {
      "name": "suite-command",
      "required": false
    },
    {
      "name": "package",
      "required": true
    },
    {
      "name": "patches",
      "required": true
    },
    {
      "name": "out",
      "required": true
    },
    {
      "name": "repo",
      "required": false
    },
    {
      "name": "workers",
      "required": false
    },
    {
      "name": "direction",
      "required": false
    },
    {
      "name": "concurrency",
      "required": false
    },
    {
      "name": "max-minutes",
      "required": false
    },
    {
      "name": "max-mutants",
      "required": false
    },
    {
      "name": "build",
      "required": false
    },
    {
      "name": "tests-dir",
      "required": false
    },
    {
      "name": "unset",
      "required": false
    },
    {
      "name": "suite-timeout-ms",
      "required": false
    },
    {
      "name": "test-timeout-ms",
      "required": false
    },
    {
      "name": "confirm",
      "required": false
    },
    {
      "name": "affected",
      "required": false
    },
    {
      "name": "agent",
      "required": false
    },
    {
      "name": "history",
      "required": false
    },
    {
      "name": "timeout-multiple",
      "required": false
    },
    {
      "name": "timeout-floor-ms",
      "required": false
    },
    {
      "name": "budget-ms",
      "required": false
    },
    {
      "name": "commit",
      "required": false
    },
    {
      "name": "line-map",
      "required": false
    },
    {
      "name": "timeout-ms",
      "required": false
    },
    {
      "name": "tests",
      "required": false
    },
    {
      "name": "max-selected",
      "required": false
    },
    {
      "name": "confirm-count",
      "required": false
    }
  ],
  "title": "probatio mutate.run",
  "description": "Scores a batch of mutants against the project's own suite. mutate sealed prints this shape too, with fixEdited, olderTestCatch, and miss. A kill only from tests the fix commit edited is a miss: ok is false and killed is 0. Every command prints one JSON object. schemaVersion changes when a field is renamed, removed, or changes meaning. A new field does not change it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "summary",
    "next",
    "nextCall"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "mutate.run"
    },
    "summary": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCall": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    },
    "killed": {
      "type": "integer",
      "minimum": 0
    },
    "unviable": {
      "type": "integer",
      "minimum": 0
    },
    "unviableIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "survived": {
      "type": "integer",
      "minimum": 0
    },
    "flaky": {
      "type": "integer",
      "minimum": 0
    },
    "timeouts": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "noCoverage": {
      "type": "integer",
      "minimum": 0
    },
    "notStarted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suiteCommand": {
      "type": "string"
    },
    "baselineMs": {
      "type": [
        "number",
        "null"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "wholeSuite": {
            "type": "boolean"
          },
          "reused": {
            "type": "boolean"
          },
          "cause": {
            "enum": [
              null,
              "test",
              "build"
            ]
          },
          "next": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "outcome",
          "command"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "op": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "file",
          "line"
        ]
      }
    },
    "rest": {
      "type": "integer",
      "minimum": 0
    },
    "flakyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgetHit": {
      "type": "boolean"
    },
    "commit": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "kills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cause": {
            "enum": [
              "test",
              "build"
            ]
          },
          "killedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "file",
                "line"
              ]
            }
          }
        },
        "required": [
          "id",
          "killedBy"
        ]
      }
    },
    "full": {
      "type": "string"
    },
    "fixEdited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "olderTestCatch": {
      "type": "boolean"
    },
    "miss": {
      "type": "boolean"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "schemaVersion",
      "ok",
      "command",
      "summary",
      "next",
      "nextCall"
    ]
  }
}
