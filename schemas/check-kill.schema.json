{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IronAdamant/Probatio/blob/main/schemas/check-kill.schema.json",
  "title": "probatio check-kill",
  "description": "Done only when the mutant is killed (or does not build) and the suite is still green. Every command prints one JSON object. schemaVersion changes when a field is renamed, removed, or changes meaning. A new field does not change it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "summary",
    "next",
    "nextCall"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "check-kill"
    },
    "summary": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCall": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    },
    "done": {
      "type": "boolean"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "cause": {
      "enum": [
        null,
        "test",
        "build"
      ]
    },
    "killedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suiteGreen": {
      "type": "boolean"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "done",
      "outcome",
      "killedBy",
      "suiteGreen"
    ]
  }
}
