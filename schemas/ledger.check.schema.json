{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IronAdamant/Probatio/blob/main/schemas/ledger.check.schema.json",
  "title": "probatio ledger.check",
  "description": "Runs every ledger bug and compares each outcome with ledger/<id>.golden.json. A caught bug that is not caught now is a regression. Every command prints one JSON object. schemaVersion changes when a field is renamed, removed, or changes meaning. A new field does not change it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "summary",
    "next",
    "nextCall"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "ledger.check"
    },
    "summary": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCall": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    },
    "caught": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "regressed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unrecorded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "recorded": {
            "type": [
              "string",
              "null"
            ]
          },
          "actual": {
            "type": "string"
          },
          "next": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "recorded",
          "actual"
        ]
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "full": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "commit"
      ]
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "caught",
      "total",
      "regressed",
      "changed",
      "unrecorded",
      "rows",
      "run"
    ]
  }
}
