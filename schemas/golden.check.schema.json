{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IronAdamant/Probatio/blob/main/schemas/golden.check.schema.json",
  "title": "probatio golden.check",
  "description": "Compares a recorded golden table with a new one. Contract changes need a Golden-Change trailer. Every command prints one JSON object. schemaVersion changes when a field is renamed, removed, or changes meaning. A new field does not change it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "summary",
    "next",
    "nextCall"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "golden.check"
    },
    "summary": {
      "type": "string"
    },
    "next": {
      "type": "string"
    },
    "nextCall": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      ]
    },
    "wording": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariant": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "boolean"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "wording",
      "contract",
      "invariant",
      "updated"
    ]
  }
}
